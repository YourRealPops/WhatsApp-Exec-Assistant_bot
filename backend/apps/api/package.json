{
  "name": "@exec-assistant/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:dev": "tsx watch src/index.ts",
    "cli": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/time.test.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@exec-assistant/ai": "workspace:*",
    "@exec-assistant/calendar": "workspace:*",
    "@exec-assistant/db": "workspace:*",
    "@exec-assistant/whatsapp": "workspace:*",
    "express": "^4.19.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}
