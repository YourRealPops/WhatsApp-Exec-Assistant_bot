# Copy to backend/.env (or the repo root .env) and fill in real values.
# Every variable below is read by apps/api, apps/worker, or both.
# Placeholders only — never commit real secrets.

# ---------------------------------------------------------------------------
# Core (required)
# ---------------------------------------------------------------------------
# Postgres connection string shared by the API and the worker.
DATABASE_URL=postgres://user:password@localhost:5432/ecos

# Public origin of this service — used for the webhook URL and for the
# calendar connect links we send to users. Set this in production.
PUBLIC_BASE_URL=https://ecos.example.com

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
# Port the API listens on (worker ignores it). Default 3000.
PORT=3000

# ---------------------------------------------------------------------------
# OAuth state signing (required when Google Calendar is configured)
# ---------------------------------------------------------------------------
# HMAC key for signed connect links and OAuth `state`; at least 32 characters.
# Generate one with: openssl rand -base64 32
OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters

# ---------------------------------------------------------------------------
# Google Calendar
# ---------------------------------------------------------------------------
# OAuth client from the Google Cloud console. When both are set the API needs
# OAUTH_STATE_SECRET, and the worker sends "reconnect" links using
# PUBLIC_BASE_URL + OAUTH_STATE_SECRET.
# Requested scope: https://www.googleapis.com/auth/calendar.events
# Redirect URI: $PUBLIC_BASE_URL/auth/google/callback
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# ---------------------------------------------------------------------------
# WhatsApp / Meta Cloud API
# ---------------------------------------------------------------------------
# SENDER=console prints messages to the terminal; SENDER=whatsapp talks to Meta.
SENDER=console
META_ACCESS_TOKEN=replace-with-meta-access-token
META_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
# App secret used to verify x-hub-signature-256 on the webhook (required in production).
META_APP_SECRET=replace-with-meta-app-secret
# Token echoed back during the webhook subscription handshake.
META_VERIFY_TOKEN=replace-with-verify-token
META_API_VERSION=v21.0
# Allow unsigned webhook posts for local curl testing. Leave false in production.
ALLOW_UNSIGNED_WEBHOOK=false

# ---------------------------------------------------------------------------
# LLM (optional — without a key the assistant falls back to rules)
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Reminder ladder (worker)
# ---------------------------------------------------------------------------
# Minutes before an event start, comma separated.
REMINDER_OFFSETS=15,10,5,0
# How far ahead to materialise reminders and sync the calendar.
LOOKAHEAD_DAYS=14
# Worker loop interval (ms) and per-account Google sync interval (minutes).
TICK_MS=15000
SYNC_INTERVAL_MIN=5
# Reminder send retries and how many due reminders are claimed per tick.
MAX_SEND_ATTEMPTS=3
DISPATCH_BATCH=50

# ---------------------------------------------------------------------------
# Reminder templates (optional — proactive sends outside the 24h window)
# ---------------------------------------------------------------------------
# Approve a utility template in Meta with params [title, time] and name it here.
REMINDER_TEMPLATE_NAME=
REMINDER_TEMPLATE_LANGUAGE=en

# ---------------------------------------------------------------------------
# Alarm calls (optional — Twilio)
# ---------------------------------------------------------------------------
# off | console | twilio. Defaults to twilio when the credentials below exist.
ALARM_MODE=off
ALARM_VOICE=Polly.Joanna
ALARM_LANGUAGE=en-US
ALARM_RING_SECONDS=30
TWILIO_ACCOUNT_SID=
# Use either an API key + secret, or the account auth token.
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15550000000

# ---------------------------------------------------------------------------
# Development only
# ---------------------------------------------------------------------------
# Serve the fixture calendar (standup / investor call / gym) for users without
# a connected Google account. Defaults to on until GOOGLE_CLIENT_ID is set.
DEV_CALENDAR=true
# Mount read-only GET /debug/* routes and keep the legacy ?user=<id> connect
# link. Leave false in production.
DEBUG_ROUTES=false
# Fallback timezone for new users when the platform cannot detect one.
DEFAULT_TIMEZONE=Africa/Lagos
# Local CLI identity (pnpm dev:cli): a phone string and display name.
CLI_PHONE=cli-local
CLI_NAME=
